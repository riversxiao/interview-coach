# 复制成 .env 后填写：cp .env.example .env

# ============================================================
# 语音脑：豆包实时语音模型 3.0（Seeduplex，全双工）
# 控制台：https://console.volcengine.com/speech/new/setting/apikeys
# 开通服务：端到端实时语音大模型
# ============================================================
VOLC_API_KEY=
VOLC_REALTIME_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
VOLC_MODEL=1.2.6.1
# 云舟 2.0：沉稳男声；也可换 zh_female_vv_uranus_bigtts（Vivi 2.0）
VOLC_VOICE=zh_male_m191_uranus_bigtts

# ============================================================
# 分析脑：OpenAI 兼容的强文本模型（负责出题 + 深度反馈）
# 默认 DeepSeek；也可换成火山方舟 / 通义 / OpenAI 等
# ============================================================
BRAIN_API_KEY=
BRAIN_BASE_URL=https://api.deepseek.com
BRAIN_MODEL=deepseek-chat
# 生成复盘报告时可单独指定更强的模型，留空则沿用 BRAIN_MODEL
BRAIN_REPORT_MODEL=

# ============================================================
# 服务
# ============================================================
HOST=127.0.0.1
PORT=8000
