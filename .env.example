# 复制成 .env 后填入真实值：cp .env.example .env
# .env 已在 .gitignore 中，不要提交真实密钥。

# ---- DeepSeek（默认示例）----
OPENAI_API_KEY=sk-你的密钥
OPENAI_BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

